# Copy to .env and fill in real values. .env is gitignored — never commit real credentials.
#
# Credentials for the hackathon AWS account (WSParticipantRole) — get these from the AWS
# Workshop Studio event portal ("AWS Console" / "CLI" access panel). These are short-lived
# session credentials and expire; re-copy fresh ones here when boto3 starts getting
# ExpiredTokenException.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
